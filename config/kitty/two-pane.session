# 1 primary window on left (60%), 1 secondary window on right (40%)
#    +------------------------------------+-------------------------+
#    |                                    |                         |
#    |                                    |                         |
#    |                                    |                         |
#    |              Window 1              |        Window 2         |
#    |              (Master)              |       (Right Pane)      |
#    |            full_size=1             |         (agy -c)        |
#    |                                    |                         |
#    |                                    |                         |
#    |                                    |                         |
#    +------------------------------------+-------------------------+
#    <-------------- 60% ----------------><---------- 40% ---------->
#                 bias=60
layout tall:bias=60;full_size=1

# Primary window (Left)
launch --var role=master fish

# Secondary window (Right)
launch fish -c "agy -c"

# Focus primary window
focus_matching_window var:role=master
